#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma code_page(65001)

IDI_APP_ICON ICON "res/gupet.ico"
1 24 "res/gupet.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,2,0
PRODUCTVERSION 2,1,2,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "danyash frizov"
            VALUE "FileDescription", "GUPet — пиксельный питомец"
            VALUE "FileVersion", "2.1.2.0"
            VALUE "InternalName", "gupet"
            VALUE "LegalCopyright", "© 2026 Danyash Frizov"
            VALUE "OriginalFilename", "gupet.exe"
            VALUE "ProductName", "GUPet"
            VALUE "ProductVersion", "2.1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 380, 415
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GUPet — Настройки питомца"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // Left card: Appearance & Size
    GROUPBOX        "Внешний вид и размер", -1, 10, 8, 175, 275
    CONTROL         "", IDC_PREVIEW_AREA, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 18, 22, 158, 85
    
    LTEXT           "Вид питомца:", -1, 18, 114, 70, 8
    AUTORADIOBUTTON "GUPet", IDC_SPECIES_GUPET, 18, 126, 45, 10, WS_GROUP
    AUTORADIOBUTTON "Кошка", IDC_SPECIES_CAT, 68, 126, 45, 10
    AUTORADIOBUTTON "Собака", IDC_SPECIES_DOG, 120, 126, 48, 10

    LTEXT           "Цветовая палитра:", -1, 18, 144, 90, 8
    COMBOBOX        IDC_PALETTE_COMBO, 18, 156, 158, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Масштаб питомца:", -1, 18, 178, 75, 8
    EDITTEXT        IDC_SIZE_EDIT, 118, 175, 36, 13, ES_AUTOHSCROLL | ES_CENTER
    LTEXT           "x", -1, 158, 178, 10, 8
    CONTROL         "", IDC_SIZE_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 14, 192, 166, 20
    RTEXT           "4.0x", IDC_SIZE_VALUE, 110, 214, 66, 8

    LTEXT           "Когда засыпать:", -1, 18, 234, 70, 8
    COMBOBOX        IDC_SLEEP_COMBO, 90, 232, 86, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // Right card: Behaviors & Actions
    GROUPBOX        "Поведение и возможности", -1, 195, 8, 175, 275
    AUTOCHECKBOX    "Самостоятельно гулять", IDC_CHK_WANDER, 203, 22, 155, 11
    AUTOCHECKBOX    "Реплики и облачка фраз", IDC_CHK_PHRASES, 203, 37, 155, 11
    AUTOCHECKBOX    "Гравитация и физика", IDC_CHK_GRAVITY, 203, 52, 155, 11
    AUTOCHECKBOX    "Реакция на встряхивание", IDC_CHK_SHAKE, 203, 67, 155, 11
    AUTOCHECKBOX    "Звуковые отклики", IDC_CHK_HAPTICS, 203, 82, 155, 11
    AUTOCHECKBOX    "Оставлять кучки", IDC_CHK_POOP, 203, 97, 155, 11
    AUTOCHECKBOX    "Танец под музыку", IDC_CHK_DANCE, 203, 112, 155, 11
    AUTOCHECKBOX    "Всегда поверх всех окон", IDC_CHK_TOPMOST, 203, 127, 155, 11
    AUTOCHECKBOX    "Режим призрака (клик насквозь)", IDC_CHK_GHOST, 203, 142, 160, 11
    AUTOCHECKBOX    "Автозапуск при входе", IDC_CHK_AUTOSTART, 203, 157, 155, 11

    LTEXT           "Быстрые команды:", -1, 203, 177, 120, 8
    PUSHBUTTON      "Позвать в центр", IDC_BTN_RECENTER, 203, 189, 78, 14
    PUSHBUTTON      "Сказать фразу", IDC_BTN_SAY, 286, 189, 76, 14
    PUSHBUTTON      "Сделать кучку", IDC_BTN_POOP_NOW, 203, 208, 78, 14
    PUSHBUTTON      "Очистить кучки", IDC_BTN_CLEAN_POOP, 286, 208, 76, 14

    // Bottom section: Custom Skins
    GROUPBOX        "Пользовательские скины (.gupet)", -1, 10, 290, 360, 68
    LTEXT           "Выбор скина:", -1, 18, 305, 70, 8
    COMBOBOX        IDC_SKIN_COMBO, 18, 316, 235, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Сбросить", IDC_BTN_RESET_SKIN, 260, 315, 52, 15
    PUSHBUTTON      "+ Импорт .gupet...", IDC_BTN_IMPORT_SKIN, 18, 336, 100, 15
    LTEXT           "Формат архива: manifest.json и кадры 18 × 13 px", -1, 126, 339, 230, 8, WS_DISABLED

    // Stats & Close
    LTEXT           "Поглаживаний: 0   |   Кучек убрано: 0", IDC_TXT_STATS, 12, 370, 260, 8
    DEFPUSHBUTTON   "Готово", IDOK, 315, 390, 55, 16
END
